(version 1)

# Apply even to same-net vias. Thermal ground pads have filled/capped vias.
# The independent QA audit checks mask expansion and the exact 11 exceptions.
(rule "Keep via holes outside SMD lands"
  (constraint physical_hole_clearance (min 0.10mm))
  (condition "A.Type == 'Via' && B.Pad_Type == 'SMD' && B.Pad_Number != '' && !(A.NetName == 'GND' && B.NetName == 'GND' && ((B.Reference == 'U1' && B.Pad_Number == '41') || (B.Reference == 'U3' && B.Pad_Number == '9')))"))

# Keep all non-ground via barrels out of the crystal reference area.
(rule "Ground vias only beneath crystal"
  (condition "A.Type == 'Via' && A.NetName != 'GND' && A.intersectsArea('XTAL_REFERENCE')")
  (constraint disallow via))

# Exact widths requested for routed copper; GND retains its existing widths.
(rule "Signal tracks 0.15 mm"
  (condition "A.NetName != 'GND' && !(A.NetName == '+3V3' || A.NetName == '+5V' || A.NetName == 'V3A' || A.NetName == 'VBUS_FUSED' || A.NetName == 'VBUS_USB' || A.NetName == 'VDD_SPI')")
  (constraint track_width (min 0.15mm) (opt 0.15mm) (max 0.15mm)))

(rule "Power tracks 0.20 mm"
  (condition "A.NetName == '+3V3' || A.NetName == '+5V' || A.NetName == 'V3A' || A.NetName == 'VBUS_FUSED' || A.NetName == 'VBUS_USB' || A.NetName == 'VDD_SPI'")
  (constraint track_width (min 0.20mm) (opt 0.20mm) (max 0.20mm)))
