# KiCad local state, locks, autosaves, and backups (Windows and Linux)
*.kicad_prl
*.lck
*.bak
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_pro-bak
*.sch-bak
*.brd-bak
*.pro-bak
*.kicad_sch~
*.kicad_pcb~
*.kicad_pro~
# Match backup directories at any depth, including mixed-case Windows names.
*-[Bb][Aa][Cc][Kk][Uu][Pp][Ss]/
_autosave-*
~*

# Local design history and downloaded tools
/[Bb][Aa][Cc][Kk][Uu][Pp]/
/[Bb][Aa][Cc][Kk][Uu][Pp][Ss]/
/tmp/
/.history/
/.claude/
/en/
*.log

# Python and operating-system caches
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
Desktop.ini

# Local credentials
.env
.env.*
!.env.example
!.env.sample
